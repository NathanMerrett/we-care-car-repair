---
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
	/** Up to 60 characters. */
	title: string;
	/** Up to 155 characters. */
	description: string;
	/** Hides the page from search engines, e.g. the style guide. */
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<Font cssVariable="--font-barlow" preload={[{ weight: 400 }]} />
		<Font cssVariable="--font-barlow-condensed" preload={[{ weight: 700 }]} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		top: 0.5rem;
		left: 0.5rem;
		z-index: 20;
		padding: 0.5rem 1rem;
		border-radius: var(--radius-button);
		background: var(--color-ink);
		color: var(--color-ink-text);
		transform: translateY(-200%);
	}

	.skip-link:focus {
		transform: none;
	}
</style>
