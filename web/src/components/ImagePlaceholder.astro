---
// Stands in for a real workshop photo until the client sends one. Never swap
// it for a stock or AI image.

interface Props {
	/** The shot that's needed, e.g. "Inside the workshop: bays and equipment". */
	shot: string;
	/** CSS aspect ratio. */
	ratio?: string;
	tone?: 'light' | 'dark';
	class?: string;
}

const { shot, ratio = '16 / 9', tone = 'light', class: className } = Astro.props;
---

<div
	class:list={['image-placeholder', `image-placeholder--${tone}`, className]}
	style={`aspect-ratio: ${ratio}`}
	role="img"
	aria-label={`Photo to come: ${shot}`}
>
	<svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
		<path
			d="M4 8h3l2-3h6l2 3h3v11H4z M12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linejoin="round"></path>
	</svg>
	<p><strong>Photo to come</strong><br />{shot}</p>
</div>

<style>
	.image-placeholder {
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 0.75rem;
		width: 100%;
		padding: 1.5rem;
		overflow: hidden;
		border-radius: var(--radius);
		font-size: var(--text-small);
		text-align: center;
	}

	.image-placeholder--light {
		background: repeating-linear-gradient(
			-45deg,
			var(--color-bg-alt) 0 12px,
			var(--color-surface) 12px 24px
		);
		border: 1px dashed var(--color-border);
		color: var(--color-text-muted);
	}

	.image-placeholder--dark {
		background: repeating-linear-gradient(
			-45deg,
			var(--color-ink) 0 12px,
			color-mix(in oklch, var(--color-ink), white 6%) 12px 24px
		);
		border: 1px dashed var(--color-ink-border);
		color: var(--color-ink-muted);
	}

	p {
		max-width: 24rem;
	}

	strong {
		font-weight: 600;
	}
</style>
