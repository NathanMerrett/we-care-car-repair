---
// The business name as text. TODO(client): swap for the logo once the brand
// files arrive.
import { business } from '../data/business';

interface Props {
	tone?: 'light' | 'dark';
}

const { tone = 'dark' } = Astro.props;
---

<a class:list={['wordmark', `wordmark--${tone}`]} href="/">{business.name}</a>

<style>
	.wordmark {
		font-family: var(--font-heading);
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0.01em;
		text-decoration: none;
		white-space: nowrap;
	}

	.wordmark--dark {
		color: var(--color-text);
	}

	.wordmark--light {
		color: var(--color-ink-text);
	}

	@media (min-width: 48rem) {
		.wordmark {
			font-size: 1.5rem;
		}
	}
</style>
